# Dependencies
node_modules/

# Build output
dist/

# Raw INEGI data — stays local, not committed.
# We only commit the PROCESSED outputs (data/geojson/, data/catalogs/)
# so anyone cloning can run the service without re-downloading from
# inegi.org.mx or installing GDAL.
data/raw/

